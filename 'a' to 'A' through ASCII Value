#include<stdio.h>

int main()
{
    char ch;
    printf("Enter Small letter\n");
    scanf("%c", &ch);
    
    if(ch >= 'a' && ch <='z')
        {
            ch = ch - 32;
            printf("Capital letter =%c\n", ch);
        }
    else 
        {
            printf("Wrong Input\n");
        }
       
    return 0;
}
